[
  {
    "name": "morning-notify",
    "schedule": "0 9 * * *",
    "action": "notify",
    "params": {
      "message": "Good morning. PersonalAssistant is running."
    }
  },
  {
    "name": "nas-uptime",
    "schedule": "@every 1h",
    "action": "run_on_node",
    "params": {
      "node_id": "nas",
      "command": "uptime"
    }
  },
  {
    "name": "checkin-every-6h",
    "schedule": "0 */6 * * *",
    "action": "notify",
    "params": {
      "message": "Scheduled check-in (every 6 hours)."
    }
  }
]
