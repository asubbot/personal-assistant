{
  "version": 1,
  "telegram": {
    "token_path": "telegram_bot_token.txt",
    "users_path": "telegram_users.json",
    "notify_chat_id": 0,
    "max_message_length": 200
  },
  "tools": {
    "text_based_enabled": true,
    "always_include": [],
    "llm_escalation": {
      "enabled": true,
      "max_per_user_message": 2,
      "baseline_index": 0
    },
    "create_tool_secret_patterns": []
  },
  "tool_pre_selection": {
    "tool_search_top_k": 10,
    "tool_min_count": 1,
    "tool_fallback_cap": 50
  },
  "llm_providers": [
    {
      "type": "ollama",
      "endpoint": "http://localhost:11434/v1",
      "api_key_path": "",
      "model": "llama3:8b",
      "supports_tools": false,
      "default_temperature": 0.3,
      "default_max_tokens": 1024,
      "supports_json_mode": true,
      "default_response_format": "text",
      "http_timeout": "60s"
    },
    {
      "type": "ollama",
      "endpoint": "http://localhost:11434/v1",
      "api_key_path": "",
      "model": "qwen3:8b",
      "supports_tools": false,
      "default_temperature": 0.3,
      "default_max_tokens": 1024,
      "supports_json_mode": true,
      "default_response_format": "text",
      "http_timeout": "60s"
    },
    {
      "type": "openai",
      "endpoint": "https://api.openai.com/v1",
      "api_key_path": "openai_api_key.txt",
      "model": "gpt-4o-mini",
      "supports_tools": true,
      "default_temperature": 0.3,
      "default_max_tokens": 4096,
      "supports_json_mode": true,
      "default_response_format": "text",
      "http_timeout": "120s"
    }
  ],
  "paths": {
    "memory_dir": "memory",
    "log_path": "pa.log",
    "vector_index_path": "pa_vectors.sqlite",
    "llm_log_dir": "llm_logs",
    "llm_log_retention_days": 7,
    "jobs_db_path": "jobs.sqlite",
    "ssh_known_hosts_path": "known_hosts",
    "tool_catalog_path": "tools.yaml",
    "skills_dir": "skills"
  },
  "embedding": {
    "type": "openai",
    "endpoint": "https://api.openai.com/v1",
    "api_key_path": "openai_api_key.txt",
    "model": "text-embedding-3-small",
    "dimensions": 1536,
    "batch_size": 100,
    "http_timeout": "120s"
  },
  "nodes": {
    "nas": {
      "host": "192.168.1.100",
      "port": 22,
      "dedicated_user": "pa-runner",
      "auth": {
        "private_key_path": "/path/to/private/key"
      },
      "command_allowlist_path": "nas_allowlist"
    }
  },
  "log_redaction": {
    "additional_patterns": [
      {
        "id": "custom_secret",
        "regex": "\\bsecret-[0-9]+\\b",
        "replacement": "[REDACTED]"
      }
    ]
  },
  "pa_timezone": "UTC",
  "conversation_context": {
    "max_dynamic_system_runes": 10000,
    "vector_search_top_k": 10
  },
  "read_memory": {
    "max_span_days": 31,
    "max_output_bytes": 262144
  },
  "write_memory": {
    "max_append_bytes": 65536,
    "max_file_bytes": 5242880
  },
  "runtime_skills": {
    "enabled": false,
    "max_skills_per_turn": 2,
    "tool_vector_top_k_cap": 20
  },
  "web_tools": null,
  "conversation_session": null,
  "intent_classifier": null,
  "observability_http": null,
  "vector_store_reliability": {
    "journal_mode": "WAL",
    "busy_timeout": "5s",
    "synchronous": "NORMAL",
    "foreign_keys": false
  },
  "jobs_store_reliability": {
    "journal_mode": "WAL",
    "busy_timeout": "5s",
    "synchronous": "NORMAL",
    "foreign_keys": true
  }
}
