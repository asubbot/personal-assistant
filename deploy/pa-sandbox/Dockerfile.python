# pa-sandbox:python — REQ-09.005 (EP-009)
# Build: docker build -f Dockerfile.python -t pa-sandbox:python .

# Override if your registry uses a different tag (see README).
ARG PYTHON_IMAGE=python:3.14-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install into image site-packages as root (readable by all users); runtime user is non-root.
RUN pip install --no-cache-dir \
    requests \
    httpx \
    beautifulsoup4 \
    lxml

RUN useradd --create-home --shell /bin/bash --uid 1000 app

WORKDIR /work
RUN chown -R app:app /work

USER app

# Default command: idle; real entry is whatever the tool template passes to docker run.
CMD ["python", "-c", "print('pa-sandbox:python ok')"]
