# pa-sandbox:node — REQ-09.006 (EP-009)
# Build: docker build -f Dockerfile.node -t pa-sandbox:node .

FROM node:22-bookworm-slim

ENV NODE_ENV=production

# Official image includes user `node` (UID 1000). Install deps and run as that user.
WORKDIR /work
RUN chown node:node /work

USER node

RUN npm init -y && npm install --no-audit --no-fund \
    axios \
    node-fetch@2 \
    cheerio

# Default command: sanity check; workloads come from tool templates.
CMD ["node", "-e", "console.log('pa-sandbox:node ok')"]
