{
    "version": 1,
    "telegram": {
      "token_path": "./.secrets/telegram_bot_token.txt",
      "users_path": "./.secrets/telegram_users.json",
      "max_message_length": 200
    },
    "llm_providers": [
        {
            "type": "openai",
            "endpoint": "https://api.openai.com/v1",
            "api_key_path": "./.secrets/openai_api_key.txt",
            "model": "gpt-4o-mini"
        }
    ],
    "paths": {
      "memory_dir": "./data/memory",
      "log_path": "./data/pa.log",
      "vector_index_path": "./data/pa_vectors.sqlite",
      "llm_log_dir": "./data/llm_logs",
      "scheduled_tasks_path": ""
    },
    "embedding": {
      "type": "openai",
      "endpoint": "https://api.openai.com/v1",
      "api_key_path": "./.secrets/openai_api_key.txt",
      "model": "text-embedding-3-small",
      "dimensions": 1536
    },
    "nodes": {}
  }