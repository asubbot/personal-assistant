# Path to main config JSON file (optional; default: ./config/config.json)
# PA_CONFIG_PATH=./config/config.json

# Log level: info (default) or debug (case-insensitive).
# At debug, the core logs full LLM request and response in the handler; at info, only metadata.
# PA_LOG_LEVEL=info

# Secrets (tokens, API keys, SSH keys) are not in env; they are file paths
# referenced from the config JSON (e.g. token_path, api_key_path, private_key_path).
