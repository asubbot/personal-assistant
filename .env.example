# Optional: copy this file to `.env` in the repo root. Docker Compose loads `.env` into the `pa` service
# (see docker-compose.yml `env_file`). Do not commit real secrets here — tokens/keys stay in files under .secrets/.
#
# Directory containing config.json (optional; default: ./.config).
# This directory is the base for config-related paths (users_path, allowlist, scheduled_tasks).
# PA_CONFIG_DIR=./.config

# Base directory for data paths: memory_dir, log_path, vector_index_path, llm_log_dir.
# Relative path values in config are joined with this base. Optional; default: .
# PA_DATA_DIR=./data

# Base directory for secret file paths: token_path, api_key_path, private_key_path.
# Relative path values in config are joined with this base. Optional; default: .
# PA_SECRETS_DIR=.

# Log level. Optional; default: info. Allowed: info or debug (case-insensitive).
# At debug, the core logs full LLM request and response in the handler; at info, only metadata.
# PA_LOG_LEVEL=info

# Secrets (tokens, API keys, SSH keys) are not in env; they are file paths
# referenced from the config JSON (e.g. token_path, api_key_path, private_key_path).
