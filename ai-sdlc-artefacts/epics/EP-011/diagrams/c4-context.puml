@startuml c4-context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SetDefaultLegendEntries("")

UpdateElementStyle(person, $fontColor="black", $bgColor="#08427B", $borderColor="#073B6F")
UpdateElementStyle(system, $fontColor="black", $bgColor="#1168BD", $borderColor="#0B5DAD")
UpdateElementStyle(external_system, $fontColor="black", $bgColor="#999999", $borderColor="#8A8A8A")

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam nodesep 80
skinparam ranksep 100
skinparam ArrowColor #707070
skinparam ComponentBorderColor #707070

title PersonalAssistant — System Context (C1) — EP-011 Native web search and HTTPS fetch

Person(user, "User", "User of the assistant")
System(pa, "PersonalAssistant", "Personal assistant (orchestration, tools, LLM calls)")
System_Ext(telegram, "Telegram", "Messaging / Bot API")
System_Ext(llm_ext, "LLM API / Model", "OpenAI-compatible HTTP API")
System_Ext(brave, "Brave Search API", "Web search over HTTPS")
System_Ext(ddg, "DuckDuckGo", "Web search over HTTPS")
System_Ext(httpsweb, "HTTPS web hosts", "Public HTTPS content")

Rel(user, telegram, "Uses")
Rel(pa, telegram, "Bot API")
Rel(pa, llm_ext, "Completions; native tool execution")
Rel(pa, brave, "web_search (HTTPS)")
Rel(pa, ddg, "web_search (HTTPS)")
Rel(pa, httpsweb, "web_fetch (HTTPS)")

@enduml
