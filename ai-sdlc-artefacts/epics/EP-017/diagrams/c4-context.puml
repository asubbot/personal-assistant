@startuml C4 Context - PersonalAssistant EP-017

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SetDefaultLegendEntries("")
UpdateElementStyle(person, $fontColor="black", $bgColor="#08427B", $borderColor="#073B6F")
UpdateElementStyle(system, $fontColor="black", $bgColor="#1168BD", $borderColor="#0B5DAD")
UpdateElementStyle(external_system, $fontColor="black", $bgColor="#999999", $borderColor="#8A8A8A")

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam nodesep 80
skinparam ranksep 100
skinparam ArrowColor #707070

title PersonalAssistant - System Context (C1) — EP-017 Intent Classifier

Person(user, "User", "User of the assistant")
System(pa, "PersonalAssistant", "Two-stage intent classifier, tiered prompt assembly")
System_Ext(telegram, "Telegram", "Messaging / Bot API")
System_Ext(llm_main, "Main LLM", "Chat completions")
System_Ext(llm_class, "Classification LLM", "Cheap model for ambiguous intents")
System_Ext(embed, "Embedding API", "Embeddings for RAG (full tier only)")

Rel(user, telegram, "Uses")
Rel(pa, telegram, "Bot API")
Rel(pa, llm_main, "Main completion")
Rel(pa, llm_class, "Classification (ambiguous only)")
Rel(pa, embed, "Embed query (full tier)")

@enduml
