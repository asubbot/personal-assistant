@startuml C4 Context - PersonalAssistant EP-016

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SetDefaultLegendEntries("")
UpdateElementStyle(person, $fontColor="black", $bgColor="#08427B", $borderColor="#073B6F")
UpdateElementStyle(system, $fontColor="black", $bgColor="#1168BD", $borderColor="#0B5DAD")
UpdateElementStyle(external_system, $fontColor="black", $bgColor="#999999", $borderColor="#8A8A8A")

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam nodesep 80
skinparam ranksep 100
skinparam ArrowColor #707070

title PersonalAssistant - System Context (C1) — EP-016 Manual notes and vector memory

Person(user, "User", "User of the assistant")
System(pa, "PersonalAssistant", "Long-term notes.md, write_memory, split vector retrieval")
System_Ext(telegram, "Telegram", "Messaging / Bot API")
System_Ext(llm_ext, "LLM API / Model", "Chat and embeddings")
System_Ext(fs, "Filesystem", "memory_dir, vector SQLite")

Rel(user, telegram, "Uses")
Rel(pa, telegram, "Bot API")
Rel(pa, llm_ext, "LLM and embeddings")
Rel(pa, fs, "memory_dir, vector index")

@enduml
